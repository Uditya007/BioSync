<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>BioSync</string>
    <key>CFBundleIdentifier</key>
    <string>com.example.biosync.watchkitapp</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    
    <!-- HealthKit Permissions -->
    <key>NSHealthShareUsageDescription</key>
    <string>BioSync reads your Heart Rate, HRV, Resting Heart Rate, and Sleep Analysis to compute your Recovery, Stress, and Sleep scores.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>BioSync needs permission to write health metrics if workout tracking is enabled.</string>
    
    <!-- Watch Background Execution Modes -->
    <key>WKBackgroundModes</key>
    <array>
        <string>app-refresh</string>
    </array>
</dict>
</plist>
